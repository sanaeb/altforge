# Frontend environment variables — copy to .env.local for local overrides.
# In production (Cloudflare Pages), set these via the dashboard.

# Base URL of the AltForge backend.
# Local default (used when this variable is unset) is http://localhost:8080.
# In production, point this to the deployed backend, e.g.
#   VITE_API_BASE_URL=https://altforge-backend.fly.dev
VITE_API_BASE_URL=
